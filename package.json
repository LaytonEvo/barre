{
  "name": "barre-by-kelly",
  "version": "0.1.0",
  "description": "Website and members platform for Barre By Kelly",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrast": "node design/contrast-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --local > lib/db/database.types.ts",
    "db:reset": "supabase db reset",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run check:contrast",
    "lint:fix": "eslint . --fix",
    "test:db": "tests/db/run.sh",
    "stripe:sync": "tsx scripts/stripe-sync.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "waiver:publish-draft": "tsx scripts/publish-draft-waiver.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "audit:security": "tsx scripts/security-audit.ts",
    "db:migrate": "node scripts/apply-migrations.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaytonEvo/barre.git"
  },
  "bugs": {
    "url": "https://github.com/LaytonEvo/barre/issues"
  },
  "homepage": "https://github.com/LaytonEvo/barre#readme",
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@mux/mux-node": "^15.5.0",
    "@mux/mux-player-react": "^3.13.4",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  }
}
