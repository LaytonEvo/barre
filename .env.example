# =============================================================================
# Copy to .env.local and fill in. Never commit .env.local.
#
# Only NEXT_PUBLIC_* values reach the browser. Everything else is server-only
# and is validated by lib/env.ts at startup.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# `supabase start` prints these for local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# BYPASSES ROW LEVEL SECURITY. Webhooks, cron and seeding only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google sign-in (optional locally) ---------------------------------------
# Also set auth.external.google.enabled = true in supabase/config.toml.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# --- Stripe ------------------------------------------------------------------
# Test keys from https://dashboard.stripe.com/test/apikeys. Use sk_test_* until
# the live-mode checklist at M9 — a live key here will take real money.
STRIPE_SECRET_KEY=

# From `npm run stripe:listen`, which prints a whsec_* on startup. It is
# different from the dashboard's webhook secret and changes each time you
# restart the listener.
STRIPE_WEBHOOK_SECRET=

# After setting the keys:
#   npm run stripe:sync      push products and prices to Stripe
#   npm run stripe:listen    forward webhooks to your dev server

# --- Resend (M3 onwards) -----------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Barre By Kelly <hello@example.com>"

# --- Mux (M7) ----------------------------------------------------------------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing keys are for short-lived playback tokens. Server-side only, always.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# --- Twilio (M8, flag-gated — leave empty unless feature_sms_enabled is on) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Cron --------------------------------------------------------------------
# Shared secret for the scheduled job routes, so only the scheduler can call
# them. Any long random string: `openssl rand -hex 32`.
CRON_SECRET=

# --- Analytics (optional) ----------------------------------------------------
# Plausible. Loaded only after cookie consent.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Monitoring (optional) ---------------------------------------------------
SENTRY_DSN=
